// Quest Booking Platform — PostgreSQL (e.g. Supabase)
// Run: npx prisma migrate dev

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  OWNER
}

enum BookingStatus {
  /// Заявка на созвон (слот не блокируется).
  REQUEST
  /// Устаревший холд под оплату (код оставлен на будущее).
  PENDING
  PAID
  CANCELLED
}

enum FeedbackKind {
  WISH
  REVIEW
  BUG
  OTHER
}

enum FeedbackVoteValue {
  LIKE
  DISLIKE
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String?
  phone     String?
  age       Int?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings           Booking[]
  messagesSent       ChatMessage[] @relation("MessageSender")
  messagesReceived   ChatMessage[] @relation("MessageReceiver")
  feedback           Feedback[]
  feedbackVotes      FeedbackVote[]
  feedbackComments   FeedbackComment[]
}

model Feedback {
  id        String       @id @default(cuid())
  userId    String
  kind      FeedbackKind @default(WISH)
  message   String
  createdAt DateTime     @default(now())

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes    FeedbackVote[]
  comments FeedbackComment[]

  @@index([createdAt])
  @@index([userId])
}

model FeedbackVote {
  id         String            @id @default(cuid())
  feedbackId String
  userId     String
  value      FeedbackVoteValue
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, userId])
  @@index([feedbackId])
  @@index([userId])
}

model FeedbackComment {
  id         String   @id @default(cuid())
  feedbackId String
  userId     String
  message    String
  createdAt  DateTime @default(now())

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([feedbackId, createdAt])
  @@index([userId])
}

model City {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quests Quest[]
  actors Actor[]
}

model Quest {
  id          String   @id @default(cuid())
  title       String
  description String?
  image       String?
  /** SEO/a11y alt for cover; empty → fallback from title + city */
  imageAlt    String?
  price       Decimal  @db.Decimal(10, 2)
  cityId      String
  /** Manual catalog order within a city (admin drag-and-drop). */
  sortOrder   Int       @default(0)
  /** Soft-hide from catalog; hard delete only from archive. */
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  city  City   @relation(fields: [cityId], references: [id], onDelete: Restrict)
  slots Slot[]

  @@unique([cityId, title])
  @@index([cityId])
  @@index([cityId, sortOrder])
  @@index([archivedAt])
}

model Slot {
  id        String   @id @default(cuid())
  startTime DateTime
  endTime   DateTime
  isBooked  Boolean  @default(false)
  questId   String
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quest       Quest        @relation(fields: [questId], references: [id], onDelete: Cascade)
  bookings    Booking[]
  assignments Assignment[]

  @@unique([questId, startTime])
  @@index([questId])
  @@index([startTime])
}

model Booking {
  id        String        @id @default(cuid())
  /// Null для гостевой заявки без аккаунта.
  userId    String?
  slotId    String
  status    BookingStatus @default(REQUEST)
  paymentId String?
  /// Контакт из формы заявки (имя).
  contactName  String?
  /// Контакт из формы заявки (телефон, нормализованный).
  contactPhone String?
  /// Число людей в заявке.
  partySize    Int?
  /// Email из формы (необязательный) или аккаунта.
  contactEmail String?
  /// Заметки / пожелания к броне (админ).
  note      String?
  /// До какого момента PENDING удерживает слот. Для REQUEST/PAID/CANCELLED обычно null.
  expiresAt DateTime? @db.Timestamptz(3)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  slot Slot  @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([slotId])
  @@index([status, expiresAt])
  @@index([contactPhone, createdAt])
}

model Actor {
  id         String   @id @default(cuid())
  name       String
  hourlyRate Decimal  @db.Decimal(10, 2)
  cityId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  city        City         @relation(fields: [cityId], references: [id], onDelete: Restrict)
  assignments Assignment[]

  @@index([cityId])
}

model Assignment {
  id      String @id @default(cuid())
  actorId String
  slotId  String

  actor Actor @relation(fields: [actorId], references: [id], onDelete: Cascade)
  slot  Slot  @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@unique([actorId, slotId])
  @@index([slotId])
}

model ChatMessage {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  text       String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([senderId, receiverId])
}
