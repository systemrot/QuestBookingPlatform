# --- PostgreSQL на своём сервере (docker compose up -d postgres) ---
POSTGRES_DB="quest_booking"
POSTGRES_USER="quest"
POSTGRES_PASSWORD="replace-with-a-strong-password"
DATABASE_URL="postgresql://quest:replace-with-a-strong-password@127.0.0.1:5432/quest_booking"
# Размер пула соединений приложения (по умолчанию 10).
# DATABASE_POOL_MAX=10

# Схема: npm run db:deploy (prisma migrate deploy).
# Если БД уже создана без истории миграций (старый Supabase):
#   npx prisma migrate resolve --applied 0_init

# --- Перенос данных Supabase → свой Postgres (npm run db:copy) ---
# SOURCE_DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
# TARGET_DATABASE_URL="postgresql://quest:[PASSWORD]@127.0.0.1:5432/quest_booking"

# Supabase по-прежнему работает: при хосте *.pooler.supabase.com пул сам включает
# pgbouncer-режим (порт 6543, маленький пул). Для отката достаточно вернуть его URL.

# NextAuth — generate e.g. openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Yandex ID OAuth — https://oauth.yandex.ru/
# Redirect: https://your-domain/api/auth/callback/yandex and http://localhost:3000/api/auth/callback/yandex
AUTH_YANDEX_ID=""
AUTH_YANDEX_SECRET=""

# VK OAuth (legacy oauth.vk.com / VK ID app) — https://dev.vk.com/ / https://id.vk.com/
# Redirect: https://your-domain/api/auth/callback/vk and http://localhost:3000/api/auth/callback/vk
AUTH_VK_ID=""
AUTH_VK_SECRET=""

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Redirect: https://your-domain/api/auth/callback/google and http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional in dev; set in production to your public URL
# AUTH_URL="https://your-domain.com"
# NEXT_PUBLIC_APP_URL="https://your-domain.com"

# SEO verification meta tags (Google Search Console / Яндекс.Вебмастер)
# GOOGLE_SITE_VERIFICATION=""
# YANDEX_VERIFICATION=""

# --- Платежи: mock | yookassa | robokassa (без ключа — всегда mock) ---
# PAYMENT_PROVIDER=yookassa

# ЮKassa: https://yookassa.ru — в ЛК создайте платёж, возьмите shopId и секретный ключ.
# Webhook URL в кабинете ЮKassa: https://ваш-домен/api/payments/yookassa/webhook
# YOOKASSA_SHOP_ID=""
# YOOKASSA_SECRET_KEY=""

# Robokassa: https://robokassa.ru — пароли #1 (оплата) и #2 (уведомления).
# Result URL: https://ваш-домен/api/payments/robokassa/result
# ROBOKASSA_MERCHANT_LOGIN=""
# ROBOKASSA_PASSWORD_1=""
# ROBOKASSA_PASSWORD_2=""
# Тестовый режим Robokassa: ROBOKASSA_TEST=1
