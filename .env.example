# PostgreSQL (Supabase): use the standard URI. Prisma 7 + @prisma/adapter-pg expects a normal
# postgres connection string (not prisma+postgres).
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Optional override only for one-off scripts (migrate/seed). Do NOT point the Next.js app
# at session pooler (5432) under load — free tier caps ~15 sessions (EMAXCONNSESSION).
# DATABASE_URL_SESSION="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Direct Postgres URL for prisma migrate / db:seed (Supabase: Settings → Database → Connection string → URI, port 5432).
# The pooler (6543) may drop connections during long seed scripts.
# DIRECT_URL="postgresql://postgres:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# --- Перенос на Frankfurt (временно). Старые DATABASE_URL не удаляй, пока не проверишь. ---
# NEW_DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[NEW_REF].supabase.co:5432/postgres"
# NEW_DATABASE_URL="postgresql://postgres.[NEW_REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# NextAuth — generate e.g. openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Yandex ID OAuth — https://oauth.yandex.ru/
# Redirect: https://your-domain/api/auth/callback/yandex and http://localhost:3000/api/auth/callback/yandex
AUTH_YANDEX_ID=""
AUTH_YANDEX_SECRET=""

# VK OAuth (legacy oauth.vk.com / VK ID app) — https://dev.vk.com/ / https://id.vk.com/
# Redirect: https://your-domain/api/auth/callback/vk and http://localhost:3000/api/auth/callback/vk
AUTH_VK_ID=""
AUTH_VK_SECRET=""

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Redirect: https://your-domain/api/auth/callback/google and http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional in dev; set in production to your public URL
# AUTH_URL="https://your-domain.com"
# NEXT_PUBLIC_APP_URL="https://your-domain.com"

# --- Платежи: mock | yookassa | robokassa (без ключа — всегда mock) ---
# PAYMENT_PROVIDER=yookassa

# ЮKassa: https://yookassa.ru — в ЛК создайте платёж, возьмите shopId и секретный ключ.
# Webhook URL в кабинете ЮKassa: https://ваш-домен/api/payments/yookassa/webhook
# YOOKASSA_SHOP_ID=""
# YOOKASSA_SECRET_KEY=""

# Robokassa: https://robokassa.ru — пароли #1 (оплата) и #2 (уведомления).
# Result URL: https://ваш-домен/api/payments/robokassa/result
# ROBOKASSA_MERCHANT_LOGIN=""
# ROBOKASSA_PASSWORD_1=""
# ROBOKASSA_PASSWORD_2=""
# Тестовый режим Robokassa: ROBOKASSA_TEST=1
